{
  "version": "1.0",
  "services": [
    {
      "id": "agent-data-pro-api",
      "name": "Agent Data Pro",
      "description": "Premium research articles, live crypto prices, and token safety checks for AI agents. Pay via x402 protocol on Base Network.",
      "type": "api",
      "endpoint": "https://agentdatapro.com",
      "docs": "https://agentdatapro.com/api/openapi",
      "serviceName": "Agent Data Pro",
      "tags": ["research", "crypto", "analytics", "ai-agents", "on-chain-data", "token-safety", "honeypot"],
      "iconUrl": "https://agentdatapro.com/icon-128.png",
      "payment": {
        "protocol": "x402",
        "currency": "USDC",
        "network": "base"
      },
      "capabilities": [
        {
          "path": "/api/articles",
          "method": "GET",
          "description": "List all available premium research articles with prices and previews. Free to call.",
          "parameters": []
        },
        {
          "path": "/api/articles/{id}",
          "method": "GET",
          "description": "Get full article content — requires x402 payment ($0.01–$0.30 USDC).",
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "The unique identifier of the article to retrieve (e.g., 'on-chain-trading-signals')"
            }
          ]
        },
        {
          "path": "/api/price/{symbol}",
          "method": "GET",
          "description": "Get live cryptocurrency price data (USD price, 24h change, 7d change, market cap, volume). Free to call.",
          "parameters": [
            {
              "name": "symbol",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "Cryptocurrency symbol (e.g., BTC, ETH, SOL)"
            }
          ]
        },
        {
          "path": "/api/token/{address}/safety",
          "method": "GET",
          "description": "Check ERC-20 token safety on Base, Ethereum, or BSC — honeypot detection, taxes, and contract risks. Requires x402 payment ($0.01 USDC).",
          "parameters": [
            {
              "name": "address",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "The ERC-20 token contract address (0x + 40 hex characters)"
            },
            {
              "name": "chain",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "default": "8453"
              },
              "description": "Chain ID: 8453 (Base, default), 1 (Ethereum), or 56 (BSC)"
            }
          ]
        }
      ]
    }
  ]
}
